    <string>migs music reads your Music app playlists so you can pick which ones to sync to your phone.</string>
    <!-- Sparkle auto-update.
         SUFeedURL: appcast hosted on GitHub Pages, updated on every release.
         SUPublicEDKey: Ed25519 public key Sparkle uses to verify each update's
         signature. The matching private key is in the macOS Keychain (account
         "ed25519" under "https://sparkle-project.org") with backups documented
         in workspace/SPARKLE_BACKUPS.md.
         SUEnableAutomaticChecks: yes — Sparkle silently checks once a day in
         the background. The user can also click the version label in the
         popover footer to force a check immediately. -->
    <key>SUFeedURL</key>
    <string>https://michaelhball.github.io/migs-music-mac/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>KepJDVwz+MXZ4wA4EFNyMKnFebciFzNKrXTuO3GtDw8=</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
</dict>
